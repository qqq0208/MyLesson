<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mdkj</groupId>
        <artifactId>MyLesson</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>ml-generator</artifactId>
    <packaging>war</packaging>
    <name>ml-generator Maven Webapp</name>
    <url>http://maven.apache.org</url>
    <dependencies>
        <!--mysql-connector-j：数据库驱动-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!--mybatis-flex-spring-boot3-starter：MyBatisFlex框架-->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
            <version>${mybatis-flex.version}</version>
        </dependency>
        <!--HikariCP：MyBatisFlex框架数据源-->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!--mybatis-flex-codegen：MyBatisFlex框架代码生成器-->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-codegen</artifactId>
            <version>${mybatis-flex-codegen.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>ml-generator</finalName>
    </build>
</project>
